
# 数据配置
FAISS_INDEX_PATH=../data/indexes/faiss
WHOOSH_INDEX_PATH=../data/indexes/whoosh
DATABASE_PATH=../data/database/xiaoyao_search.db

# API配置
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# 日志配置
LOG_LEVEL=info
LOG_FILE=../data/logs/app.log

# ========== MCP 服务器配置 ==========
MCP_SSE_ENABLED=true
MCP_SERVER_NAME=xiaoyao-search
MCP_SERVER_VERSION=1.0.0
MCP_SSE_PATH=/mcp/sse
MCP_DEFAULT_LIMIT=20
MCP_DEFAULT_THRESHOLD=0.5
MCP_VOICE_ENABLED=true
MCP_VOICE_MAX_DURATION=30

# ========== 分块索引配置 ==========
# 单次向量推理的批大小（GPU 建议 256；CPU 环境会自动降到 32）
CHUNK_EMBEDDING_BATCH_SIZE=256

# 流式构建时每批处理的分块数（内存紧张时可调低到 2048）
CHUNK_PIPELINE_BATCH_CHUNKS=4096

# 分块向量量化方式: flat（不压缩） / sq8（4 倍压缩，默认） / fp16（2 倍压缩）
# sq8 召回约 98%-99%，体积约为 Flat 的 1/4；升级后首次启动会自动迁移已有索引（不重新嵌入）
CHUNK_FAISS_QUANTIZER=sq8

# 量化训练采样数量（默认 50000）
CHUNK_FAISS_TRAINING_SAMPLE=50000

# 启动时自动迁移已有分块向量索引（默认 true；迁移失败会保留原索引）
CHUNK_FAISS_MIGRATE_ON_STARTUP=true
